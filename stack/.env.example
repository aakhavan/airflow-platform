# Local defaults only, from the official Airflow 3.3.2 docker-compose.yaml.
# python -m airflow_platform.stack up copies this file to stack/.env (git-ignored) when .env is missing.

# User ID inside the Airflow containers. On Linux set it to the output of `id -u` so files
# in the bind mounts are owned by you; on Docker Desktop (Windows/macOS) 50000 is fine.
AIRFLOW_UID=50000

# Host port of the UI and REST API.
AIRFLOW_PORT=8080

# Admin login of the FAB auth manager that the official 3.3.2 compose file uses
# (documented local default; change it for anything beyond a laptop).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Empty by default in the official file (connections are stored unencrypted locally).
FERNET_KEY=

# Airflow Variables for governor_profile_raw (docs/projects/governor.md). Airflow reads
# AIRFLOW_VAR_<NAME> as the Variable <name>; the DAG renders them when the task runs.
# Values are the governor test bed's documented local defaults (../governor/testbed/README.md
# and testbed/apply_roles.py); laptop only.
AIRFLOW_VAR_DOCKER_URL="tcp://docker-proxy:2375"
# Governor runs from the ../governor-airflow worktree, so compose names its volume
# governor-airflow_governor-data; after the merge (run from ../governor) it is governor_governor-data.
AIRFLOW_VAR_GOVERNOR_DATA_VOLUME="governor-airflow_governor-data"
AIRFLOW_VAR_GOVERNOR_PG_HOST="host.docker.internal"
AIRFLOW_VAR_GOVERNOR_PG_PORT="55432"
AIRFLOW_VAR_GOVERNOR_PG_DB="shop"
AIRFLOW_VAR_GOVERNOR_BUILD_USER="governor_build"
AIRFLOW_VAR_GOVERNOR_BUILD_PASSWORD="governor_build_local"
